{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hbmartin/legolization/schemas/bundle-v1.schema.json",
  "title": "Legolization portable bundle record, version 1",
  "type": "object",
  "required": [
    "schema",
    "version",
    "identity",
    "source",
    "configuration",
    "quality",
    "status",
    "stages",
    "artifacts",
    "warnings",
    "verdicts",
    "pending"
  ],
  "additionalProperties": true,
  "properties": {
    "schema": { "const": "legolization.bundle/v1" },
    "version": { "type": "string", "minLength": 1 },
    "identity": {
      "type": "object",
      "required": [
        "input_sha256",
        "config_sha256",
        "legolization_version",
        "catalog_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "input_sha256": { "$ref": "#/$defs/sha256" },
        "config_sha256": { "$ref": "#/$defs/sha256" },
        "legolization_version": { "type": "string", "minLength": 1 },
        "catalog_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "source": {
      "type": "object",
      "required": ["filename", "sha256"],
      "additionalProperties": false,
      "properties": {
        "filename": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "relative_path": { "type": "string", "minLength": 1 }
      }
    },
    "configuration": {
      "type": "object",
      "required": ["sha256", "values"],
      "additionalProperties": false,
      "properties": {
        "sha256": { "$ref": "#/$defs/sha256" },
        "values": { "type": "object" }
      }
    },
    "versions": {
      "type": "object",
      "required": ["legolization", "python", "libraries", "catalog_sha256"],
      "additionalProperties": false,
      "properties": {
        "legolization": { "type": "string" },
        "python": { "type": "string" },
        "libraries": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "catalog_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "quality": { "enum": ["fast", "balanced", "exhaustive", "direct"] },
    "status": {
      "enum": [
        "in-progress",
        "complete",
        "partial",
        "unbuildable",
        "error",
        "cancelled",
        "interrupted"
      ]
    },
    "exit_code": { "type": ["integer", "null"] },
    "stages": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["status", "warnings", "artifacts", "detail"],
        "additionalProperties": false,
        "properties": {
          "status": {
            "enum": [
              "pending",
              "running",
              "complete",
              "partial",
              "failed",
              "skipped",
              "cancelled",
              "interrupted"
            ]
          },
          "warnings": { "type": "array", "items": { "type": "string" } },
          "artifacts": { "type": "array", "items": { "type": "string" } },
          "error": { "type": ["string", "null"] },
          "detail": { "type": "object" }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "stage", "kind"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "stage": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "sha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }
        }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "verdicts": { "type": "object" },
    "pending": {
      "type": "array",
      "items": { "type": "object" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
